# Web / API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Runtime persistence gate
MATH_RUNTIME_BACKEND=memory # dev/test; set to postgres only after migrations 0031-0034 are applied and Supabase RPC is verified
MATH_ADULT_BACKEND=memory # dev/test only until a PostgreSQL-backed Parent/Teacher projection repository exists
MATH_ASSIGNMENT_BACKEND=memory # dev/test only until a PostgreSQL-backed Assignment repository exists
MATH_CONTENT_BACKEND=memory # dev/test only until a PostgreSQL-backed Content Delivery repository exists

MATH_ADULT_PROJECTION_REPO=in-memory-v1
MATH_ASSIGNMENT_REPO=in-memory-v1
